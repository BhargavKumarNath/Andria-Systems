# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# Required: FRED API key for macroeconomic data ingestion.
# Register for free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional: Override pipeline settings via environment variables.
# All ANDRIA_ prefixed variables map to the Settings hierarchy.
# Examples:
#   ANDRIA_DASHBOARD__PORT=9000
#   ANDRIA_INGEST__MEMORY_LIMIT_GB=8
#   ANDRIA_EXPERIMENT__SEED=123
